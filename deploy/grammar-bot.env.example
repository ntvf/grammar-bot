# Reference only — install.sh creates /opt/grammar/env; change values with set-secret.sh.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna
# OPENAI_TEMPERATURE_SUPPORTED=false
# OPENAI_REASONING_EFFORT=low

DB_HOST=localhost
DB_PORT=5432
DB_NAME=grammar
DB_USER=grammar
DB_PASSWORD=

# Comma-separated Telegram chat ids allowed to use /stats (and exempt from the daily limit).
ADMIN_CHAT_IDS=
# DAILY_LIMIT=150
# Set to false to keep only metadata (latency, outcome) of AI calls, not the texts.
# LOG_AI_CONTENT=true

